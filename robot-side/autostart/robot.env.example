# /etc/tb3/robot.env — 자동 실행 설정 (install.sh 가 처음 한 번 이 파일을 복사해 만듭니다)
# 고친 뒤:  sudo tb3ctl restart
# bash 문법입니다. 값에 공백이 있으면 큰따옴표로 감싸고, 주석은 줄 맨 앞에만 쓰세요.

# ---- ROS 환경 ----
ROS_DISTRO=jazzy
# 순서대로 source 합니다 (뒤에 있는 것이 우선)
TB3_WORKSPACES="@HOME@/camera_ws @HOME@/turtlebot3_ws"
ROS_DOMAIN_ID=30
# burger | waffle_pi
TURTLEBOT3_MODEL=burger
LDS_MODEL=LDS-02

# ---- bringup ----
# 팔 없는 기본 구성
BRINGUP_CMD="ros2 launch turtlebot3_bringup robot.launch.py"
# 경로 A (Waffle Pi + 팔을 OpenCR 에 연결, 펌웨어 교체 후):
# BRINGUP_CMD="ros2 launch turtlebot3_manipulation_bringup hardware.launch.py"
# OpenCR 이 잡힐 때까지 기다릴 장치 (비우면 안 기다림)
OPENCR_DEV=/dev/ttyACM0

# ---- 카메라 (camera_ros) ----
CAMERA_ARGS="-p width:=640 -p height:=480 -p format:=RGB888"
CAMERA_TOPIC=/camera/image_raw

# ---- rosbridge ----
ROSBRIDGE_PORT=9090

# ---- 영상 (MediaMTX + image_to_rtsp.py) ----
# MediaMTX 실행 파일 위치 (install.sh --download-mediamtx 가 여기에 받음)
MEDIAMTX_BIN=@ROBOT_SIDE@/mediamtx
MEDIAMTX_CONF=@ROBOT_SIDE@/mediamtx.yml
VIDEO_FPS=15
# Pi 4 하드웨어 인코더: h264_v4l2m2m
VIDEO_ENCODER=libx264
VIDEO_BITRATE=800k

# ---- 선택 기능 (tb3ctl enable <이름> 으로 켬) ----
# vision: walle_vision 노드 (idle 로 시작 → 대시보드에서 모드 선택)
VISION_CMD="ros2 launch walle_vision vision.launch.py profile:=burger"
# arm: 월-E 팔 노드
ARM_CMD="ros2 launch walle_arm walle_arm.launch.py profile:=burger"
# mqtt: ROS 2 ↔ MQTT 브리지
MQTT_CONFIG=@ROBOT_SIDE@/bridge.yaml
# dashboard: 빌드한 대시보드(out/)를 로봇이 직접 서비스 → http://<로봇IP>:3000
DASHBOARD_DIR=@REPO@/out
DASHBOARD_PORT=3000
